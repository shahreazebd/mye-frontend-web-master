#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"


echo '🏗️👷 Styling, testing and building before committing'

# Check Prettier standards
echo '🧹🧹🧹🧹 Running prettier'

npm run format:fix ||
(
    echo '🔥🔥🔥🔥 Prettier failed 🔥🔥🔥🔥
            Prettier formate failed: View the errors above to see why.';
    false;
)

# Check ESLint Standards
echo '🧹🧹🧹🧹 Running lint'

# npm run lint ||
# (
#         echo '🔥🔥🔥🔥 Lint failed 🔥🔥🔥🔥
#             Lint failed: View the errors above to see why.'
#         false; 
# )

# Check tsconfig standards
echo '🔍🔍🔍🔍 Running type check'

npm run typecheck ||
(
    echo '🔥🔥🔥🔥 Type check failed 🔥🔥🔥🔥
            Type check failed: View the errors above to see why. 🔥🔥🔥🔥'
    false;
)

# Check build cases
echo '🏗️👷 Building the project'

npm run build ||
(
    echo '❌👷🔨❌ Build failed ❌👷🔨❌
            Next build failed: View the errors above to see why. ❌👷🔨❌'
    false;
)

# If everything passes... Now we can commit
echo '✅✅✅✅ You win this time... I am committing this now. ✅✅✅✅'
